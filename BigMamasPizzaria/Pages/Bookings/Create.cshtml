@page
@model BigMamasPizzaria.Pages.Bookings.CreateModel
@{
    ViewData["Title"] = "Book a table";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card shadow-sm">
            <div class="card-header bg-white">
                <h4 class="mb-0"><i class="bi bi-calendar-plus"></i> Book a table</h4>
            </div>
                <form method="post" asp-page="Create" class="card-body">

                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Name</label>
                        <input asp-for="Name" class="form-control" required />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Phone</label>
                        <input asp-for="Phone" type="tel" class="form-control" required />
                        <span asp-validation-for="Phone" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Booking Date & Time</label>
                        <input asp-for="BookingDate" type="datetime-local" class="form-control" id="bookingDate" required />
                        <span asp-validation-for="BookingDate" class="text-danger"></span>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Guests</label>
                        <input asp-for="GuestCount" type="number" min="1" max="20" class="form-control" id="guestCount" required />
                        <span asp-validation-for="GuestCount" class="text-danger"></span>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Select Table</label>
                        <select asp-for="SelectedTableId" class="form-select" required>
                            <option value="">-- Select a table --</option>
                            @foreach (var table in Model.AvailableTables)
                            {
                                <option value="@table.TableId">Table @table.TableId (Seats @table.Capacity)</option>
                            }
                        </select>
                        <span asp-validation-for="SelectedTableId" class="text-danger"></span>
                    </div>

                    <div class="col-12">
                        <button type="submit" id="findTables" class="btn btn-outline-secondary"
                                asp-page-handler="FindTables" formnovalidate>
                            Find available tables
                        </button>
                    </div>

                    @if (Model.AvailableTables.Count == 0)
                    {
                        <div class="col-12">
                            <div class="alert alert-warning" role="alert">
                                No tables available for the selected date, time, and guest count. Please try different parameters.
                            </div>
                        </div>
                    }
                </div>
                <button type="submit" class="btn btn-danger mt-4 w-100">Request booking</button>
            </form>
        </div>
    </div>
</div>

<!-- Opdatet: Opdaterer automatisk når dato eller guests ændres -->
@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}

        <script>
        document.getElementById('bookingDate').addEventListener('change', () => document.getElementById('findTables').click());
        document.getElementById('guestCount').addEventListener('change', () => document.getElementById('findTables').click());
    </script>

}
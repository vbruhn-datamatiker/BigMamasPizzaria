@page
@model BigMamasPizzaria.Pages.Bookings.CreateModel
@{
    ViewData["Title"] = "Book a table";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card shadow-sm">
            <div class="card-header bg-white">
                <h4 class="mb-0"><i class="bi bi-calendar-plus"></i> Book a table</h4>
            </div>
            <form method="post" class="card-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Name</label>
                        <input asp-for="Name" class="form-control" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Phone</label>
                        <input asp-for="Phone" type="tel" class="form-control" required />
                    </div>
                    <div class="col-md-5">
                        <label class="form-label">From</label>
                        <input asp-for="Start" type="datetime-local" class="form-control" />
                    </div>
                    <div class="col-md-5">
                        <label class="form-label">To</label>
                        <input asp-for="End" type="datetime-local" class="form-control" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Guests</label>
                        <input asp-for="GuestCount" type="number" min="1" class="form-control" />
                    </div>
                </div>
                <button type="submit" class="btn btn-danger mt-4 w-100">Request booking</button>
            </form>
        </div>
    </div>
</div>
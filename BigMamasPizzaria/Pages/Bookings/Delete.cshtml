@page "{id:int}"
@model BigMamasPizzaria.Pages.Bookings.DeleteModel
@{
	ViewData["Title"] = "Cancel Booking";
}

<div class="row justify-content-center">
	<div class="col-lg-6">
		<div class="alert alert-danger" role="alert">
			<h4 class="alert-heading"><i class="bi bi-exclamation-triangle"></i> Confirm Cancellation</h4>
			<p>Are you sure you want to cancel this booking? This action cannot be undone.</p>
		</div>

		@if (Model.Booking != null)
		{
			<div class="card mb-4">
				<div class="card-body">
					<h5 class="card-title">@Model.Booking.Name</h5>
					<dl class="row mb-0">
						<dt class="col-sm-4">Phone:</dt>
						<dd class="col-sm-8">@Model.Booking.Phone</dd>

						<dt class="col-sm-4">Booking Date:</dt>
						<dd class="col-sm-8">@Model.Booking.BookingDate.ToString("dd/MM/yyyy HH:mm")</dd>

						<dt class="col-sm-4">Guests:</dt>
						<dd class="col-sm-8">@Model.Booking.GuestCount</dd>

						<dt class="col-sm-4">Table:</dt>
						<dd class="col-sm-8">Table #@Model.Booking.TableId</dd>

						<dt class="col-sm-4">Status:</dt>
						<dd class="col-sm-8">
							@if (Model.Booking.Status == "Confirmed")
							{
								<span class="badge bg-success">@Model.Booking.Status</span>
							}
							else if (Model.Booking.Status == "Cancelled")
							{
								<span class="badge bg-danger">@Model.Booking.Status</span>
							}
							else
							{
								<span class="badge bg-secondary">@Model.Booking.Status</span>
							}
						</dd>
					</dl>
				</div>
			</div>

			<form method="post" class="d-flex gap-2">
				<button type="submit" class="btn btn-danger flex-grow-1"><i class="bi bi-trash"></i> Cancel Booking</button>
				<a asp-page="Index" class="btn btn-secondary flex-grow-1"><i class="bi bi-x-circle"></i> Back</a>
			</form>
		}
		else
		{
			<p>Booking not found.</p>
			<a asp-page="Index" class="btn btn-secondary">Back to Bookings</a>
		}
	</div>
</div>

@page
@model BigMamasPizzaria.Pages.Bookings.IndexModel
@{
    ViewData["Title"] = "Bookings";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2><i class="bi bi-journal-text"></i> Bookings</h2>
    <a asp-page="Create" class="btn btn-danger"><i class="bi bi-plus-lg"></i> New booking</a>
</div>

<div class="card shadow-sm table-responsive">
    <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
            <tr><th>#</th><th>Name</th><th>Table</th><th>Guests</th><th>Time</th><th>Status</th><th></th></tr>
        </thead>
        <tbody>
            @* TODO: replace with @foreach (var b in Model.Bookings) *@
            <tr>
                <td>1</td>
                <td>Jane Doe</td>
                <td>4</td>
                <td>2</td>
                <td>03/10 18:00–20:00</td>
                <td><span class="badge text-bg-warning">Pending</span></td>
                <td class="text-end">
                    <form method="post" asp-page-handler="Confirm" asp-route-id="1" class="d-inline">
                        <button class="btn btn-sm btn-success"><i class="bi bi-check-lg"></i></button>
                    </form>
                    <form method="post" asp-page-handler="Cancel" asp-route-id="1" class="d-inline">
                        <button class="btn btn-sm btn-outline-secondary"><i class="bi bi-x-lg"></i></button>
                    </form>
                </td>
            </tr>
            <tr>
                <td>2</td>
                <td>John Smith</td>
                <td>7</td>
                <td>6</td>
                <td>03/10 19:00–21:30</td>
                <td><span class="badge text-bg-success">Confirmed</span></td>
                <td></td>
            </tr>
        </tbody>
    </table>
</div>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BigMamasPizzaria</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/BigMamasPizzaria.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <style>
            /* keeps content from hiding under the fixed navbar */
            body {
                padding-top: 72px;
            }

            .bmp-navbar {
                background: linear-gradient(90deg, #8e1c16, #b3261e 50%, #e3622b);
                padding-top: .75rem;
                padding-bottom: .75rem;
            }

                .bmp-navbar .navbar-brand {
                    font-size: 1.35rem;
                    letter-spacing: .5px;
                }

                .bmp-navbar .nav-link {
                    color: rgba(255,255,255,.85) !important;
                    border-radius: .5rem;
                    padding: .4rem .9rem !important;
                    transition: background-color .15s;
                }

                    .bmp-navbar .nav-link:hover {
                        background-color: rgba(255,255,255,.15);
                        color: #fff !important;
                    }

                    .bmp-navbar .nav-link.active {
                        background-color: rgba(255,255,255,.25);
                        color: #fff !important;
                    }
    </style>
</head>
<body class="d-flex flex-column min-vh-100 bg-light">

    <header>
        <nav class="navbar navbar-expand-lg navbar-dark fixed-top bmp-navbar shadow">
            <div class="container">
                <a class="navbar-brand fw-bold" asp-page="/Index">
                    <i class="bi bi-fire"></i> Big Mammas Pizza
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                        aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav mx-auto gap-lg-2">
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Bookings/Create"><i class="bi bi-calendar-plus"></i> Book a table</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Bookings/Index"><i class="bi bi-journal-text"></i> Bookings</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Tables/Index"><i class="bi bi-grid-3x3-gap"></i> Tables</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Users/Index"><i class="bi bi-people"></i> Users</a>
                        </li>
                    </ul>
                    <a asp-page="/Bookings/Create" class="btn btn-light btn-sm fw-semibold d-none d-lg-inline-block">
                        Reserve now
                    </a>
                </div>
            </div>
        </nav>
    </header>

    <main class="container my-4 flex-grow-1">
        @if (TempData["Message"] is string msg)
        {
            <div class="alert alert-info alert-dismissible fade show">
                @msg
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @RenderBody()
    </main>

    <footer class="border-top bg-white py-3 text-center text-muted small">
        &copy; @DateTime.Now.Year Big Mammas Pizza – school project
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
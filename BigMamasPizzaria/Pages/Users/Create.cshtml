@page
@model BigMamasPizzaria.Pages.Users.CreateModel
@{
	ViewData["Title"] = "Create User";
}

<div class="row">
	<div class="col-md-6">
		<h2><i class="bi bi-person-plus"></i> Create New User</h2>

		<form method="post" class="mt-4">
			<div class="mb-3">
				<label asp-for="User.FirstName" class="form-label"></label>
				<input asp-for="User.FirstName" class="form-control" />
				<span asp-validation-for="User.FirstName" class="text-danger"></span>
			</div>

			<div class="mb-3">
				<label asp-for="User.LastName" class="form-label"></label>
				<input asp-for="User.LastName" class="form-control" />
				<span asp-validation-for="User.LastName" class="text-danger"></span>
			</div>

			<div class="mb-3">
				<label asp-for="User.Email" class="form-label"></label>
				<input asp-for="User.Email" type="email" class="form-control" />
				<span asp-validation-for="User.Email" class="text-danger"></span>
			</div>

			<div class="mb-3">
				<label asp-for="User.Phone" class="form-label"></label>
				<input asp-for="User.Phone" type="tel" class="form-control" />
				<span asp-validation-for="User.Phone" class="text-danger"></span>
			</div>

			<div class="mb-3">
				<label asp-for="User.Password" class="form-label"></label>
				<input asp-for="User.Password" type="password" class="form-control" />
				<span asp-validation-for="User.Password" class="text-danger"></span>
			</div>

			<div class="d-flex gap-2">
				<button type="submit" class="btn btn-success"><i class="bi bi-check-circle"></i> Create</button>
				<a asp-page="Index" class="btn btn-secondary"><i class="bi bi-x-circle"></i> Cancel</a>
			</div>
		</form>
	</div>
</div>

@section Scripts {
	@{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

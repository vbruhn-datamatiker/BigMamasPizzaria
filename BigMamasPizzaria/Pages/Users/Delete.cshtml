@page "{id:int}"
@model BigMamasPizzaria.Pages.Users.DeleteModel
@{
	ViewData["Title"] = "Delete User";
}

<div class="row">
	<div class="col-md-6">
		<div class="alert alert-danger" role="alert">
			<h4 class="alert-heading"><i class="bi bi-exclamation-triangle"></i> Confirm Deletion</h4>
			<p>Are you sure you want to delete this user? This action cannot be undone.</p>
		</div>

		@if (Model.User != null)
		{
			<div class="card">
				<div class="card-body">
					<h5 class="card-title">@Model.User.FullName</h5>
					<p class="card-text">
						<small class="text-muted">
							<strong>Email:</strong> @Model.User.Email<br />
							<strong>Phone:</strong> @Model.User.Phone<br />
							<strong>ID:</strong> @Model.User.UserId
						</small>
					</p>
				</div>
			</div>

			<form method="post" class="mt-4">
				<div class="d-flex gap-2">
					<button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Delete User</button>
					<a asp-page="Index" class="btn btn-secondary"><i class="bi bi-x-circle"></i> Cancel</a>
				</div>
			</form>
		}
		else
		{
			<p>User not found.</p>
			<a asp-page="Index" class="btn btn-secondary">Back to Users</a>
		}
	</div>
</div>

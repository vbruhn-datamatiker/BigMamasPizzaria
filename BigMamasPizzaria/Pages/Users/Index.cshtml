@page
@model BigMamasPizzaria.Pages.Users.IndexModel
@{
    ViewData["Title"] = "Users";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2><i class="bi bi-people"></i> Users</h2>
    <a asp-page="Create" class="btn btn-success"><i class="bi bi-plus-circle"></i> Add User</a>
</div>

<form method="get" class="input-group mb-3" style="max-width:400px">
    <input asp-for="Search" class="form-control" placeholder="Search by name or email…" />
    <button class="btn btn-outline-danger"><i class="bi bi-search"></i></button>
    <a asp-page="Index" class="btn btn-outline-secondary"><i class="bi bi-x"></i></a>
</form>

@if (Model.Users.Count == 0)
{
    <div class="alert alert-info" role="alert">
        No users found. <a asp-page="Create">Create a new user</a>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover shadow-sm">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model.Users)
                {
                    <tr>
                        <td>@user.UserId</td>
                        <td>@user.FullName</td>
                        <td>@user.Email</td>
                        <td>@user.Phone</td>
                        <td class="text-end">
                            <a asp-page="Edit" asp-route-id="@user.UserId" class="btn btn-sm btn-primary"><i class="bi bi-pencil"></i> Edit</a>
                            <a asp-page="Delete" asp-route-id="@user.UserId" class="btn btn-sm btn-danger"><i class="bi bi-trash"></i> Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
